# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environment & Secrets
.env

# Data & Databases
data/*.db
data/*.db-wal
data/*.db-shm
research.db
research.db-wal
research.db-shm
data/historical/
data/cache/
data/candidates/

# Logs
logs/
*.log

# Private Strategy Vault (Proprietary / Exclusive Strategies - Never commit to public repo)
strategies/vault/
strategies/private/

# Deny-by-default for pair strategies: ignore all strategy files inside pair subfolders
strategies/*/*.py

# Whitelist ONLY public benchmark demo strategies, inits, and documentation
!strategies/*/*_public_*.py
!strategies/EURUSD/eurusd_public_trend.py
!strategies/XAUUSD/xauusd_public_breakout.py
!strategies/BTCEUR/btceur_public_momentum.py
!strategies/**/README.md
!strategies/**/__init__.py
!strategies/**/.gitkeep
